{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Debug Experiment Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "hypothesis", "input", "preconditions", "oracle", "environment", "command", "expected", "timeout", "cleanup"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "hypothesis": {"$ref": "#/$defs/text"},
    "input": {"$ref": "#/$defs/text"},
    "preconditions": {"$ref": "#/$defs/strings"},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {"source": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}
    },
    "environment": {"enum": ["local", "test"]},
    "command": {"$ref": "#/$defs/strings"},
    "expected": {"allOf": [{"$ref": "#/$defs/strings"}], "uniqueItems": true},
    "timeout": {"type": "integer", "minimum": 1, "maximum": 300},
    "cleanup": {"const": "temporary-data"},
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "expected"],
        "properties": {
          "command": {"$ref": "#/$defs/strings"},
          "expected": {"allOf": [{"$ref": "#/$defs/strings"}], "uniqueItems": true}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "strings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
  }
}
