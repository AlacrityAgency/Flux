{
  "color": {
    "$type": "color",
    "ink": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.22, 0.02, 250]
      }
    },
    "white": {"$value": {"colorSpace": "srgb", "components": [1, 1, 1]}},
    "text": {"$value": "{color.ink}"}
  },
  "space": {
    "$type": "dimension",
    "small": {"$value": {"value": 8, "unit": "px"}}
  },
  "motion": {
    "quick": {"$type": "duration", "$value": {"value": 150, "unit": "ms"}}
  }
}
